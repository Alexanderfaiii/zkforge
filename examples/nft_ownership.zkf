// ZKForge Example: NFT Ownership Proof
// Prove you know a secret value that equals a known public root,
// without revealing the secret itself.
//
// Real-world analogy: you prove you own an NFT by showing
// your private ID matches the public merkle root — without
// disclosing the ID.

prove nft_ownership {
    input merkle_root: Public<u256>;
    input my_secret: Private<u256>;

    // The secret must equal the public root
    assert my_secret == merkle_root;

    output is_owner<bool>;
}