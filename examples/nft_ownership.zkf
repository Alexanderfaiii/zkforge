// ZKForge Example: NFT Ownership Proof
// Prove you own an NFT in a merkle tree without revealing which one.
//
// Single-level merkle tree: leaf and sibling hash to root.

prove nft_ownership {
    input merkle_root: Public<u256>;
    input leaf: Private<u256>;
    input sibling: Private<u256>;
    input path_index: Private<u256>;
    assert merkle_verify(leaf, merkle_root, sibling, path_index) == true;
    output is_owner<bool>;
}